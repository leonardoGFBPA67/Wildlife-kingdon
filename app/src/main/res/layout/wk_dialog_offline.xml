<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/wk_tv_offline_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offline_title"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/wk_tv_offline_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offline_time"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/wk_tv_offline_coins"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offline_coins"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/wk_btn_collect_offline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offline_collect"/>

</LinearLayout>